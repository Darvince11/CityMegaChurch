# ============================================================================
# Church Digital Platform — Environment Variable Template
# Copy to apps/api/.env and apps/web/.env.local and fill real values.
# NEVER commit real secrets. See docs/ENVIRONMENT.md for the full reference.
# ============================================================================

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
WEB_URL=http://localhost:3000
APP_NAME=Church Digital Platform

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://church:church@localhost:5432/church_platform
DATABASE_POOL_MAX=20
DATABASE_SSL=false

# ----------------------------------------------------------------------------
# Redis (cache + BullMQ queue)
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=cdp

# ----------------------------------------------------------------------------
# Authentication
# ----------------------------------------------------------------------------
# Secret used to sign session cookies. 32+ random bytes in production.
# Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_NAME=cdp_session
COOKIE_SECURE=false
# Argon2 / password hashing config (safe defaults)
PASSWORD_MEMORY_COST=65536
PASSWORD_TIME_COST=3
PASSWORD_PARALLELISM=1

# Initial administrator. Production requires a unique 12+ character password.
SUPERADMIN_EMAIL=superadmin@church.test
SUPERADMIN_PASSWORD=replace-with-a-unique-production-password
SEED_STRICT=false

# Optional: email verification + password reset (see EMAIL section)

# ----------------------------------------------------------------------------
# Paystack
# ----------------------------------------------------------------------------
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_CURRENCY=GHS
PAYSTACK_WEBHOOK_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ----------------------------------------------------------------------------
# Object storage (Cloudflare R2 / S3-compatible)
# ----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=church-media
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://media.example.com
# Allowed upload MIME types (comma separated)
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/gif,audio/mpeg,audio/mp4,video/mp4
UPLOAD_MAX_SIZE_BYTES=52428800

# ----------------------------------------------------------------------------
# Outbound email (e.g. Resend / SMTP)
# ----------------------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Church Digital Platform

# ----------------------------------------------------------------------------
# Monitoring & observability
# ----------------------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=debug
LOG_FORMAT=pretty

# ----------------------------------------------------------------------------
# Rate limiting
# ----------------------------------------------------------------------------
RATE_LIMIT_GLOBAL_LIMIT=300
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_AUTH_WINDOW_MS=60000

# ----------------------------------------------------------------------------
# CORS (web app origin for the API)
# ----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# ----------------------------------------------------------------------------
# 2FA (optional; used for sensitive roles)
# ----------------------------------------------------------------------------
TWO_FACTOR_APP_NAME=ChurchDigitalPlatform
OTP_ISSUER=Church Digital Platform

# ----------------------------------------------------------------------------
# Next.js web app (apps/web/.env.local only)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_APP_NAME=Church Digital Platform
