# City Mega Church web app — Vercel production environment template
# Add these keys in the Web Vercel project's Environment Variables screen.
NEXT_PUBLIC_API_URL=https://your-api-project.vercel.app
NEXT_PUBLIC_SITE_URL=https://www.your-church-domain.com
NEXT_PUBLIC_APP_NAME=City Mega Church
NEXT_PUBLIC_CHURCH_NAME=City Mega Church
NEXT_PUBLIC_CHURCH_EMAIL=info@your-church-domain.com
NEXT_PUBLIC_CHURCH_PHONE=+233000000000
NEXT_PUBLIC_CHURCH_LOCATION=Your church location
NEXT_PUBLIC_CHURCH_SERVICE_TIMES=Sunday 8:00 AM and 11:00 AM; Thursday 7:00 PM
