# City Mega Church API — Vercel production environment template
# Add these keys in the API Vercel project's Environment Variables screen.
# Do not commit a file containing real passwords, URLs, or secrets.
NODE_ENV=production
APP_NAME=City Mega Church
API_PORT=4000
APP_URL=https://www.your-church-domain.com
WEB_URL=https://www.your-church-domain.com
API_URL=https://your-api-project.vercel.app

# Managed PostgreSQL (Neon, Supabase, or another Vercel-reachable provider)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_POOL_MAX=5
DATABASE_SSL=true

# A unique random value of at least 64 characters
SESSION_SECRET=REPLACE_WITH_A_64_CHARACTER_OR_LONGER_RANDOM_SECRET
COOKIE_NAME=cdp_session
COOKIE_SECURE=true
SESSION_TTL_HOURS=168
TRUST_PROXY_HOPS=1

# Password hashing
PASSWORD_MEMORY_COST=65536
PASSWORD_TIME_COST=3
PASSWORD_PARALLELISM=1

# Only the final public website URL belongs here. Add preview URL(s) if needed.
CORS_ORIGINS=https://www.your-church-domain.com

# Rate limiting
RATE_LIMIT_GLOBAL_LIMIT=300
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_AUTH_WINDOW_MS=60000

# Optional Redis service
REDIS_URL=redis://YOUR_REDIS_HOST:6379
REDIS_PREFIX=city-mega-church

# Logs
LOG_LEVEL=info
LOG_FORMAT=json

# Initial administrator; the deployment seed creates this account only if absent.
SEED_STRICT=true
SUPERADMIN_EMAIL=admin@your-church-domain.com
SUPERADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_12_CHARACTER_OR_LONGER_PASSWORD
