# City Mega Church API — production values for Vercel
# Replace every ALL_CAPS placeholder in Vercel. Do not commit real values.

NODE_ENV=production
APP_NAME=City Mega Church

# Supabase: Dashboard → Connect → Transaction pooler
DATABASE_URL=POSTGRES_CONNECTION_STRING_WITH_SSLMODE_REQUIRE
DATABASE_POOL_MAX=5
DATABASE_SSL=true

# Session security — generate a unique random secret of 64+ characters
SESSION_SECRET=YOUR_LONG_RANDOM_SESSION_SECRET
COOKIE_SECURE=true
TRUST_PROXY_HOPS=1

# The exact HTTPS URL of your deployed website
CORS_ORIGINS=https://www.your-church-domain.com

# Initial administrator — created only if this account does not already exist
SEED_STRICT=true
SUPERADMIN_EMAIL=YOUR_ADMIN_EMAIL
SUPERADMIN_PASSWORD=YOUR_UNIQUE_12_CHARACTER_OR_LONGER_PASSWORD
