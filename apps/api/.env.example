# NODE_ENV=development|test|production
NODE_ENV=development
API_PORT=4000
APP_NAME=Church Digital Platform
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# PostgreSQL (matches infra/docker/docker-compose.dev.yml)
DATABASE_URL=postgresql://church:church@localhost:5432/church_platform
DATABASE_POOL_MAX=20
DATABASE_SSL=false

# Redis (matches infra/docker/compose.yaml)
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=cdp

# Sessions — SESSION_SECRET must be >= 32 chars and match WEB_COOKIE_SECRET
SESSION_SECRET=dev_only_change_me_0123456789abcdef_0123456789abcdef
COOKIE_NAME=cdp_session
COOKIE_SECURE=false
SESSION_TTL_HOURS=168

# Argon2id cost parameters
PASSWORD_MEMORY_COST=65536
PASSWORD_TIME_COST=3
PASSWORD_PARALLELISM=1

# CORS
CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_FORMAT=pretty