{
  "name": "@cdp/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS + Fastify monolith API for the Church Digital Platform",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cdp/database": "workspace:*",
    "@cdp/shared": "workspace:*",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-fastify": "^11.0.1",
    "@nestjs/swagger": "^11.0.3",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cdp/eslint-config": "workspace:*",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2",
    "vitest": "^3.0.5"
  }
}